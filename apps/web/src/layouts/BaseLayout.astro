---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { copy, type Locale } from '../lib/i18n';
import { getSettings } from '../lib/content';
const { locale, title, description, alternatePath } = Astro.props as { locale: Locale; title?: string; description?: string; alternatePath?: string };
const t = copy[locale];
const settings = await getSettings(locale);
---
<!doctype html>
<html lang={locale}>
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description || settings?.description || t.tagline} /><title>{title ? `${title} — ${settings?.siteName || 'SWIPE'}` : settings?.siteName || 'SWIPE'}</title></head>
  <body><a class="sr-only focus:not-sr-only" href="#main">{locale === 'it' ? 'Vai al contenuto' : 'Skip to content'}</a><Header locale={locale} settings={settings} alternatePath={alternatePath} /><main id="main"><slot /></main><footer class="border-t-2 border-ink px-5 py-8 md:px-10"><p class="mx-auto max-w-7xl text-sm">© {new Date().getFullYear()} {settings?.footerText || 'Associazione SWIPE · ' + t.tagline}</p></footer></body>
</html>
