---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { copy, type Locale } from '../lib/i18n';
const { locale, title } = Astro.props as { locale: Locale; title?: string };
const t = copy[locale];
---
<!doctype html>
<html lang={locale}>
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={t.tagline} /><title>{title ? `${title} — SWIPE` : 'SWIPE'}</title></head>
  <body><a class="sr-only focus:not-sr-only" href="#main">Skip to content</a><Header locale={locale} /><main id="main"><slot /></main><footer class="border-t-2 border-ink px-5 py-8 md:px-10"><p class="mx-auto max-w-7xl text-sm">© {new Date().getFullYear()} Associazione SWIPE · {t.tagline}</p></footer></body>
</html>
