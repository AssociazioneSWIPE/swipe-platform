---
import type { Article } from '../lib/content';
import { copy, type Locale } from '../lib/i18n';
const { article, locale } = Astro.props as { article: Article; locale: Locale };
const t = copy[locale];
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date(article.publishedAt));
---
<article class="flex h-full flex-col border-2 border-ink p-5">
  <p class="text-sm">{date}</p>
  <h2 class="mt-8 text-2xl font-bold"><a href={`/${locale}/journal/${article.slug}/`}>{article.title}</a></h2>
  <p class="mt-3">{article.excerpt}</p>
  <a class="mt-auto pt-6 font-bold" href={`/${locale}/journal/${article.slug}/`}>{t.readMore} →</a>
</article>
