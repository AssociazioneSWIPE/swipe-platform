---
import { toHTML } from '@portabletext/to-html';
import type { PortableTextBlock } from '../lib/content';
const { value = [] } = Astro.props as { value?: PortableTextBlock[] };
const html = toHTML(value as Parameters<typeof toHTML>[0]);
---
<div class="rich-text" set:html={html} />
<style>
  .rich-text { font-size: 1.125rem; line-height: 1.8; }
  .rich-text :global(p + p) { margin-top: 1.5rem; }
  .rich-text :global(h2) { font-size: 2rem; font-weight: bold; margin: 2rem 0 1rem; }
  .rich-text :global(h3) { font-size: 1.5rem; font-weight: bold; margin: 1.5rem 0 1rem; }
  .rich-text :global(a) { text-decoration: underline; }
  .rich-text :global(ul) { list-style: disc; padding-left: 1.5rem; margin: 1rem 0; }
  .rich-text :global(ol) { list-style: decimal; padding-left: 1.5rem; margin: 1rem 0; }
  .rich-text :global(blockquote) { border-left: 4px solid; padding-left: 1.5rem; margin: 2rem 0; font-style: italic; }
</style>

