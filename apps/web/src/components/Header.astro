---
import { copy, type Locale } from '../lib/i18n';
import type { SiteSettings } from '../lib/content';
const { locale, settings, alternatePath } = Astro.props as { locale: Locale; settings?: SiteSettings | null; alternatePath?: string };
const t = copy[locale];
const alternate = locale === 'it' ? 'en' : 'it';
const routes = ['home', 'manifesto', 'journal', 'support'];
const navigation = settings?.navigation ?? [
  { _key: 'manifesto', label: t.manifesto, route: 'manifesto' },
  { _key: 'journal', label: t.journal, route: 'journal' },
  { _key: 'support', label: t.support, route: 'support' },
];
---
<header class="border-b-2 border-ink px-5 py-4 md:px-10">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-5">
    <a class="font-display text-3xl tracking-tighter no-underline" href={`/${locale}/`}>{settings?.siteName || 'SWIPE'}</a>
    <nav aria-label={locale === 'it' ? 'Navigazione principale' : 'Primary navigation'} class="flex flex-wrap items-center gap-4 text-sm font-bold md:gap-7">
      {navigation.filter((item) => routes.includes(item.route)).map((item) => <a href={`/${locale}/${item.route === 'home' ? '' : item.route + '/'}`}>{item.label}</a>)}
      <a href={alternatePath || `/${alternate}/`} lang={alternate} hreflang={alternate}>{t.language}</a>
    </nav>
  </div>
</header>
