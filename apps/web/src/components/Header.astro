---
import { copy, type Locale } from '../lib/i18n';
import { sections } from '../lib/site';
import { navigationRoutes } from '../../../../packages/config/routes';
import type { SiteSettings } from '../lib/content';
const { locale, settings, alternatePath } = Astro.props as { locale: Locale; settings?: SiteSettings | null; alternatePath?: string };
const t = copy[locale];
const alternate = locale === 'it' ? 'en' : 'it';
const pagePath = Astro.url.pathname.split('/').filter(Boolean).slice(1);
const fixedPath = pagePath.length === 0 || (pagePath.length === 1 && navigationRoutes.includes(pagePath[0] as typeof navigationRoutes[number]));
const languageHref = alternatePath || (fixedPath ? `/${alternate}/${pagePath.length ? pagePath[0] + '/' : ''}` : `/${alternate}/`);
const href = (route: string) => `/${locale}/${route === 'home' ? '' : route + '/'}`;
const customNavigation = settings?.navigation?.filter((item) => navigationRoutes.includes(item.route as typeof navigationRoutes[number]));
const groupLinks = ['about', 'manifesto'] as const;
const resources = ['journal', 'guides', 'press', 'podcasts'] as const;
const label = (route: string) => route === 'journal' ? t.journal : sections[locale][route as keyof typeof sections.it][0];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand-logo" href={href('home')} aria-label={`SWIPE — ${t.home}`}><img src="/brand/swipe-logo-white.png" width="980" height="454" alt="SWIPE" /></a>
    <nav class="desktop-nav" aria-label={locale === 'it' ? 'Navigazione principale' : 'Main navigation'}>
      {customNavigation ? customNavigation.map((item) => <a href={href(item.route)}>{item.label}</a>) : <>
        <details class="nav-group"><summary>{locale === 'it' ? 'Associazione' : 'About'}</summary><div>{groupLinks.map((route) => <a href={href(route)}>{label(route)}</a>)}</div></details>
        <details class="nav-group"><summary>{sections[locale].resources[0]}</summary><div><a href={href('resources')}>{locale === 'it' ? 'Tutte le risorse' : 'All resources'}</a>{resources.map((route) => <a href={href(route)}>{label(route)}</a>)}</div></details>
        {(['events', 'research', 'contact'] as const).map((route) => <a href={href(route)}>{route === 'events' ? (locale === 'it' ? 'Eventi' : 'Activities') : label(route)}</a>)}
      </>}
    </nav>
    <div class="header-actions"><a class="language-link" href={languageHref} lang={alternate} hreflang={alternate} aria-label={t.language}>{alternate.toUpperCase()}</a><a class="button header-support" href={href('support')}>{t.support} <span aria-hidden="true">↗</span></a></div>
    <details class="mobile-nav"><summary>Menu <span aria-hidden="true">＋</span></summary><nav aria-label={locale === 'it' ? 'Navigazione mobile' : 'Mobile navigation'}>
      {customNavigation ? customNavigation.map((item) => <a href={href(item.route)}>{item.label}</a>) : [...groupLinks, 'resources', ...resources, 'events', 'research', 'contact'].map((route) => <a href={href(route)}>{label(route)}</a>)}
    </nav></details>
  </div>
</header>
<style>
  .site-header { background: var(--color-red); color: white; border-bottom: 1px solid #ffffff40; }
  .header-inner { display: flex; align-items: center; gap: 1.6rem; min-height: 112px; }
  .brand-logo { flex: 0 0 190px; } .brand-logo img { width: 190px; height: auto; }
  .desktop-nav { margin-left: auto; display: flex; align-items: center; flex-wrap: wrap; gap: 1.4rem; font-size: .8rem; font-weight: 500; }
  .desktop-nav a { text-decoration: none; } .desktop-nav a:hover { text-decoration: underline; }
  .desktop-nav, .header-actions, .mobile-nav { color: var(--color-ink); }
  .nav-group { position: relative; } summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; gap: .5rem; }
  .nav-group summary::after { content: '⌄'; } summary::-webkit-details-marker { display: none; }
  .nav-group > div { position: absolute; top: 100%; left: -1rem; z-index: 20; width: 210px; padding: .75rem; background: var(--color-ink); color: white; border-radius: 0 0 12px 12px; }
  .nav-group > div a { display: block; padding: .65rem; }
  .header-actions { display: flex; align-items: center; gap: 1.2rem; }
  .language-link { font-size: .8rem; text-underline-offset: .3em; padding-block: .75rem; }
  .header-support { white-space: nowrap; padding: .6rem 1rem; font-size: .8rem; }
  .mobile-nav { display: none; }
  @media (max-width: 1100px) {
    .header-inner { flex-wrap: wrap; gap: 0; min-height: 88px; } .brand-logo, .brand-logo img { width: 150px; flex-basis: 150px; }
    .desktop-nav { display: none; } .header-actions { margin-left: auto; }
    .mobile-nav { display: block; width: 100%; border-top: 1px solid #ffffff40; }
    .mobile-nav summary { justify-content: space-between; font-size: .85rem; padding-block: .75rem; }
    .mobile-nav nav { display: grid; grid-template-columns: 1fr 1fr; gap: .25rem; padding-bottom: 1.25rem; }
    .mobile-nav nav a { display: block; padding: .6rem 0; font-size: .9rem; }
  }
  @media (max-width: 400px) { .header-support { font-size: .72rem; padding-inline: .7rem; } .header-support span { display: none; } .header-actions { gap: .7rem; } }
</style>
