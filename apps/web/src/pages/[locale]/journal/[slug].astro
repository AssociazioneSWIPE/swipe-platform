---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RichText from '../../../components/RichText.astro';
import EditorialImage from '../../../components/EditorialImage.astro';
import { getArticle, getArticles } from '../../../lib/content';
import { isLocale, locales } from '../../../lib/i18n';
export async function getStaticPaths() {
  const paths = await Promise.all(
    locales.map(async (locale) =>
      (await getArticles(locale)).map((article) => ({ params: { locale, slug: article.slug } })),
    ),
  );
  return paths.flat();
}
const { locale: routeLocale, slug } = Astro.params;
if (!isLocale(routeLocale) || !slug) return new Response('Not found', { status: 404 });
const locale = routeLocale;
const article = await getArticle(locale, slug);
if (!article) return new Response('Not found', { status: 404 });
const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date(article.publishedAt));
const alternatePath = article.translation?.slug && article.translation.language !== locale
  ? `/${article.translation.language}/journal/${article.translation.slug}/` : undefined;
---
<BaseLayout locale={locale} title={article.seo?.title || article.title} description={article.seo?.description || article.excerpt} alternatePath={alternatePath}>
  <article class="px-5 py-16 md:px-10 md:py-24"><div class="mx-auto max-w-3xl"><a class="font-bold" href={`/${locale}/journal/`}>← Journal</a><p class="mt-12 text-sm">{date}</p><h1 class="mt-4 font-display text-5xl tracking-tighter md:text-7xl">{article.title}</h1>{article.author && <p class="mt-4">{article.author.name}</p>}{article.categories?.length && <p class="mt-4">{article.categories.map((category) => category.title).join(' · ')}</p>}<p class="mt-8 text-xl leading-relaxed">{article.excerpt}</p><EditorialImage value={article.mainImage} /><div class="mt-12"><RichText value={article.body} /></div></div></article>
</BaseLayout>
