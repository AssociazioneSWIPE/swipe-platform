---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import RichText from '../../components/RichText.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import { copy, isLocale, locales } from '../../lib/i18n';
import { homeCopy, sections, resourceSections } from '../../lib/site';
import { getLatestArticles, getPage } from '../../lib/content';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const { locale: routeLocale } = Astro.params;
if (!isLocale(routeLocale)) return new Response('Not found', { status: 404 });
const locale = routeLocale;
const t = copy[locale];
const text = homeCopy[locale];
const [articles, page] = await Promise.all([getLatestArticles(locale), getPage(locale, 'home')]);
---
<BaseLayout locale={locale} title={page?.seo?.title} description={page?.seo?.description}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{text.eyebrow}</p><h1>{page?.title || text.title}</h1>
        <p class="hero-intro">{page?.intro || text.intro}</p>
        <div class="hero-links"><a class="button button-yellow" href={`/${locale}/about/`}>{text.about} <span aria-hidden="true">↗</span></a><a class="text-link" href={`/${locale}/resources/`}>{text.resources} <span aria-hidden="true">↓</span></a></div>
      </div>
      <div class="hero-art">{page?.image ? <EditorialImage value={page.image} /> : <img src="/brand/swipe-illustration.png" alt={locale === 'it' ? 'Due persone con l’ombrello e la freccia di SWIPE' : 'Two people with SWIPE’s umbrella and arrow symbol'} width="465" height="692" fetchpriority="high" />}</div>
    </div>
    <div class="hero-baseline wrap"><span>{locale === 'it' ? 'Diritti. Comunità. Autodeterminazione.' : 'Rights. Community. Self-determination.'}</span><span aria-hidden="true">↓</span></div>
  </section>
  <section class="section-space"><div class="wrap intro-grid">
    <div><p class="eyebrow">01 / SWIPE</p><h2>{text.statement}</h2></div>
    <div><p class="editorial intro-statement">{text.values}</p><a class="underlined" href={`/${locale}/manifesto/`}>{locale === 'it' ? 'Leggi il nostro manifesto' : 'Read our manifesto'} <span aria-hidden="true">↗</span></a>{page?.body && <div class="mt-8"><RichText value={page.body} /></div>}</div>
  </div></section>
  <section class="resources-section section-space"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">02 / {sections[locale].resources[0]}</p><h2>{locale === 'it' ? 'Sapere è potere.' : 'Knowledge is power.'}</h2></div><p class="editorial">{text.resourceIntro}</p></div>
    <div class="resource-grid">{resourceSections.map((route, i) => <a class="resource-link" href={`/${locale}/${route}/`}><div class="resource-top"><span class="eyebrow">0{i + 1}</span><span aria-hidden="true">↗</span></div><h3>{sections[locale][route][0]}</h3><p>{sections[locale][route][1]}</p></a>)}</div>
  </div></section>
  <section class="section-space"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">03 / Journal</p><h2>{t.latest}</h2></div><a class="underlined" href={`/${locale}/journal/`}>{locale === 'it' ? 'Tutti gli articoli' : 'All articles'} <span aria-hidden="true">↗</span></a></div>
    {articles.length ? <div class="grid grid-cols-1 gap-8 md:grid-cols-3">{articles.map((article) => <ArticleCard article={article} locale={locale} />)}</div> : <p class="journal-empty editorial">{locale === 'it' ? 'Storie, riflessioni e voci dalla nostra comunità. Presto qui.' : 'Stories, reflections and voices from our community. Coming soon.'}</p>}
  </div></section>
  <section class="community-section section-space"><div class="wrap community-grid">
    <div><p class="eyebrow">04 / {locale === 'it' ? 'Fare rete' : 'Connect'}</p><h2>{locale === 'it' ? 'Ci incontriamo. Ci ascoltiamo. Ci sosteniamo.' : 'We meet. We listen. We support each other.'}</h2><a class="button" href={`/${locale}/events/`}>{sections[locale].events[0]} <span aria-hidden="true">↗</span></a></div>
    <div class="research-note"><p class="eyebrow">{sections[locale].research[0]}</p><h3>{text.research}</h3><p>{text.researchIntro}</p><a class="underlined" href={`/${locale}/research/`}>{locale === 'it' ? 'Il nostro approccio' : 'Our approach'} <span aria-hidden="true">↗</span></a></div>
  </div></section>
  <section class="support-section section-space"><div class="wrap support-inner"><div><p class="eyebrow">Sex work is work.</p><h2>{locale === 'it' ? 'Il cambiamento ha bisogno di te.' : 'Change needs you.'}</h2></div><a class="button button-yellow" href={`/${locale}/support/`}>{t.support} <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
<style>
  .hero { background: var(--color-red); color: white; }
  .hero .eyebrow, .hero-intro, .text-link, .hero-baseline, .support-section .eyebrow { color: var(--color-ink); }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 5rem; align-items: center; padding-block: 3rem 4rem; }
  .hero-copy h1 { font-size: clamp(2.8rem, 5.1vw, 5rem); line-height: 1.06; letter-spacing: -.035em; margin: 1.6rem 0; max-width: 720px; }
  .hero-intro { font-size: 1.04rem; line-height: 1.75; max-width: 500px; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; margin-top: 2rem; }
  .text-link { font-size: .85rem; text-underline-offset: .3em; } .hero-art { display: flex; justify-content: flex-end; }
  .hero-art > img { width: min(100%, 400px); height: auto; }
  .hero-baseline { padding-block: 1.25rem; border-top: 1px solid #ffffff66; display: flex; justify-content: space-between; font-size: .75rem; }
  h2 { font-size: clamp(2rem, 3.6vw, 3.5rem); line-height: 1.12; letter-spacing: -.025em; margin-top: 1.2rem; }
  .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; } .intro-grid h2 { max-width: 390px; }
  .intro-statement { font-size: clamp(1.35rem, 2vw, 1.8rem); line-height: 1.5; margin-bottom: 1.8rem; }
  .underlined { font-size: .9rem; font-weight: 500; text-decoration: underline; text-underline-offset: .35em; }
  .resources-section { background: #fec60d24; border-block: 1px solid #17151520; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 3rem; margin-bottom: 3rem; }
  .section-heading > p { max-width: 330px; font-size: 1.25rem; line-height: 1.5; }
  .resource-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .resource-link { border-top: 1px solid; padding-top: 1rem; text-decoration: none; }
  .resource-top { display: flex; justify-content: space-between; align-items: center; } .resource-top > span:last-child { font-size: 1.8rem; }
  .resource-link h3 { margin-block: 2.5rem 1rem; font-size: 1.8rem; }
  .resource-link:hover h3 { text-decoration: underline; text-underline-offset: .3em; }
  .resource-link p { max-width: 300px; font-size: .95rem; line-height: 1.7; }
  .journal-empty { font-size: 1.4rem; padding-block: 2rem; border-block: 1px solid #17151530; }
  .community-section { background: var(--color-rose); }
  .community-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 7rem; align-items: center; }
  .community-grid .button { margin-top: 2rem; } .research-note { border-left: 1px solid; padding-left: 3rem; }
  .research-note h3 { font-size: 1.8rem; line-height: 1.2; margin-block: 1rem; }
  .research-note > p:not(.eyebrow) { line-height: 1.7; margin-bottom: 1.5rem; }
  .support-section { color: white; background: var(--color-red); } .support-inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; }
  .support-inner h2 { max-width: 700px; } .support-inner .button { flex-shrink: 0; }
  @media (max-width: 900px) { .hero-grid { gap: 2rem; } .hero-copy h1 { font-size: clamp(2.5rem, 5.7vw, 4rem); } .intro-grid { gap: 3rem; } .community-grid { gap: 3rem; } }
  @media (max-width: 650px) {
    .hero-grid, .intro-grid, .community-grid { grid-template-columns: 1fr; }
    .hero-grid { padding-block: 2.5rem; gap: 2.5rem; } .hero-copy h1 { font-size: 2.9rem; }
    .hero-art { justify-content: center; } .hero-art > img { width: 84%; max-width: 320px; }
    .section-heading, .support-inner { align-items: start; flex-direction: column; gap: 1.5rem; }
    .resource-grid { grid-template-columns: 1fr; gap: 2.5rem; } .resource-link h3 { margin-top: 1rem; }
    .resource-link p { max-width: none; } .research-note { border-left: 0; border-top: 1px solid; padding: 2rem 0 0; }
  }
</style>
