---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RichText from '../../components/RichText.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import ResourceArchive from '../../components/ResourceArchive.astro';
import ActivityDates from '../../components/ActivityDates.astro';
import { getPage, getResources, getActivities, type ArchiveKind } from '../../lib/content';
import { isLocale, locales } from '../../lib/i18n';
import { sections, resourceSections, instagramUrl, researchApproach, type Section } from '../../lib/site';
import { pageRoutes, archiveRoutes } from '../../../../../packages/config/routes';
export function getStaticPaths() {
  return locales.flatMap((locale) => pageRoutes.filter((page) => page !== 'home').map((page) => ({ params: { locale, page } })));
}
const { locale: routeLocale, page } = Astro.params;
if (!isLocale(routeLocale) || !page || !pageRoutes.includes(page as typeof pageRoutes[number])) return new Response('Not found', { status: 404 });
const locale = routeLocale;
const route = page as Section;
const pageContent = await getPage(locale, route);
const [title, intro] = sections[locale][route];
const isArchive = archiveRoutes.includes(route as ArchiveKind);
const resources = isArchive ? await getResources(locale, route as ArchiveKind) : [];
const activities = route === 'events' ? await getActivities(locale) : [];
---
<BaseLayout locale={locale} title={pageContent?.seo?.title || pageContent?.title || title} description={pageContent?.seo?.description || pageContent?.intro || intro} alternatePath={`/${locale === 'it' ? 'en' : 'it'}/${page}/`}>
  <section class="page-heading"><div class="wrap"><p class="eyebrow">SWIPE / {title}</p><h1>{pageContent?.title || title}</h1><p class="editorial page-intro">{pageContent?.intro || intro}</p></div></section>
  <section class="section-space"><div class="wrap page-body">
    <EditorialImage value={pageContent?.image} /><RichText value={pageContent?.body} />
    {route === 'research' && !pageContent?.body?.length && <div class="research-approach">{researchApproach[locale].map((paragraph) => <p>{paragraph}</p>)}<a class="button" href={`/${locale}/contact/`}>{locale === 'it' ? 'Parliamone' : 'Let’s talk'} <span aria-hidden="true">↗</span></a></div>}
    {route === 'resources' && <div class="resource-list">{resourceSections.map((section) => <a href={`/${locale}/${section}/`}><h2>{sections[locale][section][0]} <span aria-hidden="true">↗</span></h2><p>{sections[locale][section][1]}</p></a>)}</div>}
    {isArchive && <ResourceArchive resources={resources} kind={route as ArchiveKind} locale={locale} />}
    {route === 'events' && <div class="resource-list">{activities.length ? activities.map((activity) => <article><h2><a href={`/${locale}/events/${activity.slug}/`}>{activity.title} <span aria-hidden="true">↗</span></a></h2><p>{activity.summary}</p><ActivityDates occurrences={activity.occurrences} locale={locale} /><EditorialImage value={activity.gallery?.[0]} width={800} /></article>) : <p class="empty-note">{locale === 'it' ? 'Le nostre attività saranno raccontate qui, con foto e storie dalla comunità.' : 'Our activities will be shared here, with photos and stories from the community.'}</p>}</div>}
    {route === 'support' && <a class="button button-yellow" href="https://www.paypal.com/donate/?hosted_button_id=4WJG759DXNHS4">{locale === 'it' ? 'Fai una donazione' : 'Make a donation'} <span aria-hidden="true">↗</span></a>}
    {route === 'contact' && <a class="button" href={instagramUrl}>Instagram <span aria-hidden="true">↗</span></a>}
  </div></section>
</BaseLayout>
<style>
  .page-heading { background: var(--color-red); color: white; padding-block: clamp(3rem, 7vw, 6rem); }
  .page-heading .eyebrow, .page-intro { color: var(--color-ink); }
  h1 { font-size: clamp(2.7rem, 6vw, 5rem); line-height: 1.1; letter-spacing: -.025em; margin-block: 1.5rem; }
  .page-intro { max-width: 760px; font-size: clamp(1.2rem, 2vw, 1.7rem); line-height: 1.5; }
  .page-body { max-width: 900px; min-height: 150px; }
  .resource-list { display: grid; gap: 2rem; } .resource-list > a { padding-block: 1.5rem; border-top: 1px solid; text-decoration: none; }
  h2 { font-size: 1.8rem; margin-bottom: 1rem; } .resource-list > a:hover h2 { text-decoration: underline; }
  .guide-entry p, .resource-list p { line-height: 1.7; margin-bottom: 1.5rem; }
  .empty-note { font-size: 1rem; line-height: 1.7; } .guide-entry { border-top: 1px solid; padding-top: 2rem; }
  .research-approach p { line-height: 1.8; margin-bottom: 1.5rem; }
</style>
