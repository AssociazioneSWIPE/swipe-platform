{
  "name": "swipe-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --filter @swipe/web build",
    "check": "pnpm --filter @swipe/web check",
    "dev": "pnpm --filter @swipe/web dev",
    "studio": "pnpm --filter @swipe/studio dev",
    "studio:login": "pnpm --filter @swipe/studio sanity login",
    "studio:deploy": "pnpm --filter @swipe/studio sanity deploy --schema-required"
  }
}
